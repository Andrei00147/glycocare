rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and authentication
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'oliveirandrei001@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.diabetesType is string && data.diabetesType.size() <= 100
        && (data.useInsulin is bool)
        && (data.useOralMedication is bool)
        && (data.glucoseTargetMin is number && data.glucoseTargetMin >= 20 && data.glucoseTargetMin <= 500)
        && (data.glucoseTargetMax is number && data.glucoseTargetMax >= 20 && data.glucoseTargetMax <= 500);
    }

    // User Profile Document
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin() || isSignedIn();
      allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId) || isSuperAdmin();

      // User Glucose Readings
      function isValidGlucoseReading(data) {
        return data.value is number && data.value >= 10 && data.value <= 1000
          && data.timestamp is string
          && data.userId == userId;
      }

      match /glucoseReadings/{readingId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isSignedIn();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidGlucoseReading(request.resource.data);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Meal Logs
      function isValidMealLog(data) {
        return data.carbohydrates is number && data.carbohydrates >= 0
          && data.sugars is number && data.sugars >= 0
          && data.timestamp is string
          && data.userId == userId;
      }

      match /mealLogs/{mealId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isSignedIn();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidMealLog(request.resource.data);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Weight Logs
      function isValidWeightLog(data) {
        return data.weightKg is number && data.weightKg >= 10 && data.weightKg <= 500
          && data.timestamp is string
          && data.userId == userId;
      }

      match /weightLogs/{weightId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isSignedIn();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidWeightLog(request.resource.data);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Insulin Doses
      function isValidInsulinDose(data) {
        return data.units is number && data.units >= 0 && data.units <= 300
          && data.timestamp is string
          && data.userId == userId;
      }

      match /insulinDoses/{doseId} {
        allow read: if isOwner(userId) || isSuperAdmin() || isSignedIn();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidInsulinDose(request.resource.data);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Community Recipes
    function isValidRecipe(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.author is string && data.author.size() <= 100
        && data.authorUid == request.auth.uid
        && data.ingredients is string && data.ingredients.size() <= 2000
        && data.instructions is string && data.instructions.size() <= 5000
        && data.carbohydrates is number && data.carbohydrates >= 0
        && data.calories is number && data.calories >= 0;
    }

    match /communityRecipes/{recipeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidRecipe(request.resource.data);
      allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Professional Partners (Managed exclusively by SuperAdmin oliveirandrei001@gmail.com)
    function isValidProfessional(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (data.role == 'Nutricionista' || data.role == 'Médico')
        && data.specialty is string && data.specialty.size() <= 150
        && data.registrationNumber is string && data.registrationNumber.size() <= 50
        && data.referralCode is string && data.referralCode.size() <= 50
        && data.isActive is bool;
    }

    match /professionals/{professionalId} {
      allow read: if true; // Public read so referral codes and directory work seamlessly
      allow create, update, delete: if isSuperAdmin() && isValidId(professionalId) && isValidProfessional(request.resource.data);
    }

    // Patient Links (Links between Patients and Nutritionists/Doctors)
    function isValidPatientLink(data) {
      return data.patientUid is string && data.patientUid.size() <= 128
        && data.patientEmail is string && data.patientEmail.size() <= 150
        && data.professionalEmail is string && data.professionalEmail.size() <= 150
        && data.professionalName is string && data.professionalName.size() <= 100
        && (data.professionalRole == 'Nutricionista' || data.professionalRole == 'Médico')
        && data.referralCode is string && data.referralCode.size() <= 50
        && (data.status == 'active' || data.status == 'archived');
    }

    match /patientLinks/{linkId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.professionalEmail == request.auth.token.email ||
        resource.data.professionalUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        request.resource.data.patientUid == request.auth.uid ||
        request.resource.data.professionalEmail == request.auth.token.email
      ) && isValidId(linkId) && isValidPatientLink(request.resource.data);
      // Patients cannot unlink by themselves from client; only Professional or SuperAdmin can archive/unlink
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.professionalEmail == request.auth.token.email ||
        resource.data.professionalUid == request.auth.uid
      );
    }

    // Direct Patient <-> Specialist Consultation Messaging
    match /consultationMessages/{messageId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.professionalEmail == request.auth.token.email
      );
      allow create: if isSignedIn() && isValidId(messageId) && (
        isSuperAdmin() ||
        request.resource.data.patientUid == request.auth.uid ||
        request.resource.data.professionalEmail == request.auth.token.email
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.professionalEmail == request.auth.token.email
      );
    }

    // Private Clinical Notes recorded by Nutritionists / Doctors
    match /clinicalNotes/{noteId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.professionalEmail == request.auth.token.email ||
        resource.data.professionalUid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(noteId) && (
        isSuperAdmin() ||
        request.resource.data.professionalEmail == request.auth.token.email ||
        request.resource.data.professionalUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.professionalEmail == request.auth.token.email ||
        resource.data.professionalUid == request.auth.uid
      );
    }
  }
}
